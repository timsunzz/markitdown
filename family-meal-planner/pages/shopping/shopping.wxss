.empty {
  text-align: center;
  padding: 80rpx 28rpx;
  color: #6b7066;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-btn {
  margin-top: 30rpx;
  width: 70%;
}

.total-cost {
  font-size: 30rpx;
  color: #6d6d72;
  font-weight: 700;
}

.head-note {
  margin-top: 10rpx;
  line-height: 1.5;
}

.copy-all {
  margin-top: 14rpx;
  font-size: 25rpx;
  color: #007aff;
}

.howto {
  background: #eaf3ff;
  color: #6d6d72;
  font-size: 25rpx;
  line-height: 1.7;
}

.hl {
  color: #007aff;
  font-weight: 700;
}

.item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.item + .item {
  border-top: 2rpx solid #ececee;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #c9cfc5;
  border-radius: 10rpx;
  margin-right: 20rpx;
  text-align: center;
  line-height: 36rpx;
  color: #fff;
  font-size: 26rpx;
  flex-shrink: 0;
}

.item.checked .checkbox {
  background: #007aff;
  border-color: #007aff;
}

.item.checked .item-name,
.item.checked .item-sub {
  text-decoration: line-through;
  color: #b0b5ac;
}

.item.pantry .item-name,
.item.pantry .item-sub {
  color: #9aa096;
}

.item-main {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
}

.copied-tag {
  font-size: 20rpx;
  color: #007aff;
  background: #eaf3ff;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
}

.item-sub {
  font-size: 23rpx;
  color: #8e8e93;
  margin-top: 4rpx;
}

.item-price {
  color: #6d6d72;
}

.copy-btn {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #007aff;
  border: 2rpx solid #007aff;
  border-radius: 10rpx;
  padding: 8rpx 22rpx;
  margin-left: 16rpx;
}

.bottom-space {
  height: 150rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(242, 242, 247, 0.95);
}

.bar-btn {
  font-size: 26rpx;
  padding: 0 12rpx;
}

.img-btn {
  flex: 2.4;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.copy-btn2 {
  flex: 1;
}

.next-btn {
  flex: 2.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.small {
  flex: 0.9;
}

.btn-hema {
  background: #1f7ae0;
  color: #fff;
  font-weight: 600;
  border-radius: 14rpx;
}

.btn-hema::after {
  border: none;
}
