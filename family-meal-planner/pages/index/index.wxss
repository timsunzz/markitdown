.header {
  padding: 30rpx 24rpx 6rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.date {
  font-size: 38rpx;
  font-weight: 700;
}

.family-chip {
  font-size: 24rpx;
  color: #2e7d5b;
  background: #e8f3ee;
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
}

.notice {
  background: #fff8e6;
  color: #8a6d1a;
  font-size: 25rpx;
  line-height: 1.6;
}

.meal-cost {
  font-size: 24rpx;
  font-weight: 500;
  color: #e08a00;
  margin-left: 8rpx;
}

.cost-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.cost-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #e08a00;
}

.shuffle {
  font-size: 25rpx;
  color: #2e7d5b;
  font-weight: 400;
}

.dish {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
}

.dish + .dish {
  border-top: 2rpx solid #f6f7f4;
}

.dish-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.dish-photo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.cover-breakfast {
  background: linear-gradient(135deg, #ffe9c7, #ffd18d);
}

.cover-meat {
  background: linear-gradient(135deg, #ffdccb, #ffb497);
}

.cover-veg {
  background: linear-gradient(135deg, #dcf0de, #abddb5);
}

.cover-soup {
  background: linear-gradient(135deg, #d9edf6, #abd8ea);
}

.cover-staple {
  background: linear-gradient(135deg, #f3ecda, #e5d5ae);
}

.dish-main {
  flex: 1;
  min-width: 0;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.dish-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.dish-kcal {
  font-size: 24rpx;
  color: #e08a00;
  margin-bottom: 6rpx;
}

.nutrient {
  display: flex;
  align-items: center;
  margin: 18rpx 0;
}

.n-label {
  width: 110rpx;
  font-size: 26rpx;
}

.bar {
  flex: 1;
  height: 18rpx;
  background: #eef1ec;
  border-radius: 999rpx;
  overflow: hidden;
  margin-right: 16rpx;
}

.bar-fill {
  height: 100%;
  background: linear-gradient(90deg, #7fc9a5, #2e7d5b);
  border-radius: 999rpx;
}

.n-val {
  width: 220rpx;
  text-align: right;
  font-size: 23rpx;
  color: #6b7066;
}

.nut-note {
  margin-top: 12rpx;
  line-height: 1.5;
}

.bottom-space {
  height: 140rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(246, 247, 244, 0.95);
}

.buy-btn {
  width: 100%;
}
