.hero {
  height: 320rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero-emoji {
  font-size: 140rpx;
  filter: drop-shadow(0 8rpx 16rpx rgba(60, 40, 20, 0.18));
}

.hero-photo {
  width: calc(100% - 48rpx);
  height: 360rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 24rpx;
}

.cover-breakfast {
  background: linear-gradient(135deg, #ffe9c7, #ffd18d);
}

.cover-meat {
  background: linear-gradient(135deg, #ffdccb, #ffb497);
}

.cover-veg {
  background: linear-gradient(135deg, #dcf0de, #abddb5);
}

.cover-soup {
  background: linear-gradient(135deg, #d9edf6, #abd8ea);
}

.cover-staple {
  background: linear-gradient(135deg, #f3ecda, #e5d5ae);
}

.r-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.r-name {
  font-size: 40rpx;
  font-weight: 700;
  flex: 1;
  min-width: 0;
}

.fav-chip {
  flex-shrink: 0;
  font-size: 25rpx;
  color: #c0574f;
  border: 2rpx solid rgba(192, 87, 79, 0.45);
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  margin-top: 4rpx;
}

.fav-chip.on {
  background: #fdecea;
  border-color: #f3b6b0;
}

.r-meta {
  margin-bottom: 12rpx;
}

.r-info {
  font-size: 25rpx;
}

.ing {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}

.ing + .ing {
  border-top: 2rpx solid #f6f7f4;
}

.ing-name {
  font-size: 28rpx;
}

.pantry-tag {
  font-size: 20rpx;
  color: #8a8f87;
  background: #f0f1ee;
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  margin-left: 8rpx;
}

.ing-right {
  text-align: right;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.ing-amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #2e7d5b;
}

.ing-price {
  font-size: 22rpx;
  color: #e08a00;
  margin-top: 2rpx;
}

.dish-cost-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 28rpx;
}

.dish-cost-num {
  font-size: 32rpx;
  font-weight: 700;
  color: #e08a00;
}

.cost-note {
  margin-top: 10rpx;
  line-height: 1.5;
}

.step {
  display: flex;
  margin: 20rpx 0;
}

.step-no {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #e8f3ee;
  color: #2e7d5b;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.step-text {
  font-size: 28rpx;
  line-height: 1.7;
}

.nut-grid {
  display: flex;
  justify-content: space-between;
}

.nut-item {
  flex: 1;
  text-align: center;
}

.nut-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #e08a00;
  margin-bottom: 4rpx;
}

.tip {
  font-size: 26rpx;
  line-height: 1.7;
  color: #5a6156;
  background: #f4f8f2;
  border-radius: 12rpx;
  padding: 18rpx;
}

.bottom-space {
  height: 150rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 14rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(246, 247, 244, 0.95);
}

.bar-btn {
  flex: 2;
  font-size: 28rpx;
}

.share-s {
  flex: 1;
}
