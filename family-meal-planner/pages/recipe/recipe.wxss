.r-hero {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 2rpx solid #e8e5dc;
}

.r-seal {
  width: 108rpx;
  height: 108rpx;
  font-size: 60rpx;
  border-radius: 12rpx;
}

.r-head {
  flex: 1;
  min-width: 0;
}

.r-name {
  font-size: 42rpx;
  font-weight: 600;
  line-height: 1.35;
  letter-spacing: 2rpx;
}

.r-info {
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}

.r-tags {
  margin-top: 8rpx;
}

.fav-chip {
  flex-shrink: 0;
  font-size: 24rpx;
  letter-spacing: 2rpx;
  color: #2f5ea8;
  border: 2rpx solid #2f5ea8;
  border-radius: 8rpx;
  padding: 8rpx 22rpx;
  margin-top: 6rpx;
}

.fav-chip.on {
  background: #2f5ea8;
  color: #faf9f5;
}

.meal-title {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 6rpx;
}

.sec-label {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
}

.ing {
  display: flex;
  align-items: baseline;
  padding: 16rpx 0;
}

.ing + .ing {
  border-top: 2rpx solid #f0eee6;
}

.ing-name {
  font-size: 28rpx;
  flex-shrink: 1;
}

.ing-leader {
  flex: 1;
  border-bottom: 2rpx dotted #d5d2c8;
  margin: 0 14rpx;
  min-width: 30rpx;
}

.ing-right {
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.ing-amount {
  font-size: 28rpx;
  font-weight: 500;
}

.ing-price {
  font-size: 22rpx;
  color: #8b9088;
}

.dish-cost-line {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #e8e5dc;
}

.dish-cost-num {
  font-size: 30rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.step {
  display: flex;
  margin: 24rpx 0;
  gap: 20rpx;
}

.step-no {
  font-size: 34rpx;
  color: #2f5ea8;
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
  line-height: 1.5;
}

.step-text {
  font-size: 28rpx;
  line-height: 1.75;
}

.nut-grid {
  display: flex;
  margin: 20rpx 0 8rpx;
}

.nut-item {
  flex: 1;
  text-align: center;
}

.nut-num {
  font-size: 40rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  margin-bottom: 4rpx;
}

.tip {
  margin-top: 24rpx;
  font-size: 25rpx;
  line-height: 1.8;
  color: #6e7378;
  border-left: 6rpx solid #2f5ea8;
  padding-left: 20rpx;
}

.bottom-space {
  height: 150rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 32rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(250, 249, 245, 0.96);
  border-top: 2rpx solid #e8e5dc;
}

.bar-btn {
  flex: 2;
  font-size: 28rpx;
}

.share-s {
  flex: 1;
}
