page {
  background: #f6f7f4;
  font-size: 28rpx;
  color: #2b2f2a;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  background: #ffffff;
  border-radius: 26rpx;
  padding: 30rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(38, 84, 60, 0.07);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #2e7d5b;
  background: #e8f3ee;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
  margin-right: 10rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #3a9a70, #256b4c);
  color: #fff;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(46, 125, 91, 0.28);
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #fff;
  color: #2e7d5b;
  border: 2rpx solid rgba(46, 125, 91, 0.55);
  border-radius: 18rpx;
  font-size: 28rpx;
}

.btn-ghost::after {
  border: none;
}

.muted {
  color: #8a8f87;
  font-size: 24rpx;
}

.divider {
  height: 2rpx;
  background: #f0f1ee;
  margin: 20rpx 0;
}
