/**
 * 卡卡家常菜谱 · 全局样式
 *
 * 设计语言：「一册家常菜谱」
 * 瓷白纸面 + 墨色文字 + 发丝线分隔，青花瓷蓝为唯一强调色，
 * 宋体大字做标题，不用渐变、重投影与装饰性 emoji。
 */

page {
  background: #faf9f5;
  font-size: 28rpx;
  color: #1f2328;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 宋体标题字组 */
.serif {
  font-family: "Songti SC", "Noto Serif SC", "SimSun", serif;
}

/* 章节：以留白与发丝线分隔，不再使用阴影卡片 */
.card {
  background: transparent;
  padding: 34rpx 32rpx 30rpx;
  margin: 0;
  border-bottom: 2rpx solid #e8e5dc;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.divider {
  height: 2rpx;
  background: #e8e5dc;
  margin: 22rpx 0;
}

.muted {
  color: #8b9088;
  font-size: 24rpx;
}

/* 标签：不再用色块药丸，改为点隔的小字 */
.tag {
  display: inline;
  font-size: 22rpx;
  color: #a9ada8;
  margin-right: 0;
}

.tag + .tag::before {
  content: " · ";
  color: #d5d2c8;
}

.btn-primary {
  background: #2f5ea8;
  color: #faf9f5;
  border-radius: 10rpx;
  font-size: 29rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #1f2328;
  border: 2rpx solid #c9c6bb;
  border-radius: 10rpx;
  font-size: 28rpx;
  letter-spacing: 2rpx;
}

.btn-ghost::after {
  border: none;
}

/* 青花字印：每道菜取首字，蓝底白字的小方印 */
.seal {
  width: 76rpx;
  height: 76rpx;
  border-radius: 10rpx;
  background: #2f5ea8;
  color: #faf9f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-family: "Songti SC", "Noto Serif SC", "SimSun", serif;
  flex-shrink: 0;
}

.seal.veg { background: #4a7d5f; }
.seal.soup { background: #7a91b4; }
.seal.staple { background: #8c7a5b; }
.seal.breakfast { background: #b0793a; }

/* 提示行：左侧细竖线，不用彩底 emoji 卡片 */
.notice {
  background: transparent;
  border-bottom: 2rpx solid #e8e5dc;
  border-left: 6rpx solid #2f5ea8;
  padding: 22rpx 32rpx 22rpx 26rpx;
  color: #6e7378;
  font-size: 24rpx;
  line-height: 1.7;
}
