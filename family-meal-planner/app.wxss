/**
 * 卡卡家常菜谱 · 全局样式
 *
 * 设计语言：苹果原生（iOS Human Interface）
 * 系统灰底 + 白色圆角分组 + 发丝分隔线，系统蓝为唯一强调色，
 * 全部使用系统字体（PingFang），无渐变、无投影、无装饰 emoji。
 */

page {
  background: #f2f2f7;
  font-size: 30rpx;
  color: #1c1c1e;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

/* 兼容旧的 serif 类：统一回系统字体加粗 */
.serif {
  font-family: -apple-system, "PingFang SC", sans-serif;
  font-weight: 700;
}

/* iOS 分组卡片 */
.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 30rpx;
  margin: 20rpx 28rpx;
  border-bottom: none;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 0;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.divider {
  height: 1px;
  background: #e5e5ea;
  margin: 20rpx 0;
}

.muted {
  color: #8e8e93;
  font-size: 25rpx;
}

/* 标签：点隔的脚注小字 */
.tag {
  display: inline;
  font-size: 22rpx;
  color: #aeaeb2;
  margin-right: 0;
}

.tag + .tag::before {
  content: " · ";
  color: #d1d1d6;
}

.btn-primary {
  background: #007aff;
  color: #ffffff;
  border-radius: 24rpx;
  font-size: 31rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #007aff;
  border: none;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  letter-spacing: 0;
}

.btn-ghost::after {
  border: none;
}

/* 菜品首字圆标（iOS 列表图标式的彩色圆） */
.seal {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #007aff;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  font-family: -apple-system, "PingFang SC", sans-serif;
  flex-shrink: 0;
}

.seal.meat { background: #f0664b; }
.seal.veg { background: #34c759; }
.seal.soup { background: #32ade6; }
.seal.staple { background: #a2845e; }
.seal.breakfast { background: #f5a623; }

/* 提示：白色分组内的脚注文字 */
.notice {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 20rpx 28rpx;
  padding: 24rpx 30rpx;
  color: #8e8e93;
  font-size: 25rpx;
  line-height: 1.65;
  border-left: none;
  border-bottom: none;
}
