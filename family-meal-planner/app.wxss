page {
  background: #f6f7f4;
  font-size: 28rpx;
  color: #2b2f2a;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(30, 60, 40, 0.06);
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #2e7d5b;
  background: #e8f3ee;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  margin-right: 10rpx;
}

.btn-primary {
  background: #2e7d5b;
  color: #fff;
  border-radius: 14rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: #fff;
  color: #2e7d5b;
  border: 2rpx solid #2e7d5b;
  border-radius: 14rpx;
  font-size: 28rpx;
}

.btn-ghost::after {
  border: none;
}

.muted {
  color: #8a8f87;
  font-size: 24rpx;
}

.divider {
  height: 2rpx;
  background: #f0f1ee;
  margin: 20rpx 0;
}
